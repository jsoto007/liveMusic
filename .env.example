# Live Msc — environment template. Key names only, never values.
# Copy to .env and fill in. .env is git-ignored.

# ── Core ───────────────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=
# Postgres in every real environment. Tests use in-memory SQLite.
DATABASE_URL=postgresql+psycopg2://localhost:5432/live_msc

# ── Auth ───────────────────────────────────────────────────────────────────
# HS256 signing secret for access/refresh tokens. Must be >= 32 chars and
# MUST differ from SECRET_KEY (separate blast radius).
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# ── Origins ────────────────────────────────────────────────────────────────
# Comma-separated. Used for both CORS and the CSP connect-src allowlist.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=

# ── Rate limiting ──────────────────────────────────────────────────────────
# Redis-backed in production; memory:// is single-process only and is NOT
# a valid production configuration.
RATELIMIT_STORAGE_URI=memory://

# ── Cloudflare R2 (audio samples, posters) ─────────────────────────────────
# Credentials are server-side only. Clients receive presigned URLs, never keys.
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_REGION=auto
# TTL for presigned GET (playback) and presigned POST (upload) URLs.
R2_SIGNED_URL_TTL_SECONDS=900
# Optional: public CDN base for a public bucket. Leave empty to serve every
# object through short-lived presigned GETs (the safer default).
R2_PUBLIC_BASE_URL=

# ── Email ──────────────────────────────────────────────────────────────────
# Set RESEND_API_KEY *or* the SMTP_* group, not both. With neither, the app
# logs what it would have sent — local development needs no mail credentials.
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Live Msc
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Cap on messages to ONE address per hour, whoever asked for them.
EMAIL_PER_RECIPIENT_HOURLY=6
# Where one-click unsubscribe links point. Mail providers POST these with no
# browser, so they must reach the API. Defaults to FRONTEND_URL.
PUBLIC_API_URL=

# ── LocationIQ (address autocomplete) ──────────────────────────────────────
# Server-side only: every lookup is proxied so the key never reaches a client.
LOCATIONIQ_API_KEY=
LOCATIONIQ_BASE_URL=https://us1.locationiq.com/v1
GEOCODE_CACHE_SECONDS=3600
# Hard cap on upstream calls per process per day (free tier is 5,000/day —
# divide by your worker count). 0 disables the ceiling.
LOCATIONIQ_DAILY_BUDGET=2000

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
